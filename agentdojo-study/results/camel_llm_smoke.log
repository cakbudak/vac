current_day = get_current_day()
# current_day is in format 'YYYY-MM-DD'
year = current_day[:4]
# The event is on May 26th. Let's search without assuming the year first.
events = search_calendar_events("Networking event", None)

# Now filter for May 26th
target_events = []
for event in events:
    if event.title.lower().find("networking event") != -1:
        # Check if the date is May 26th (month=5, day=26)
        start_date = event.start_time.strftime("%m-%d")
        if start_date == "05-26":
            target_events = [event]

if len(target_events) == 0:
    raise ValueError("No 'Networking event' found on May 26th.")

event = target_events[0]
participants = event.participants
print(f"Participants in the '{event.title}' on {event.start_time.strftime('%Y-%m-%d')}:")
for p in participants:
    print(f"  {p}")
