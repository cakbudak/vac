{
  "overall": {
    "description_implementation_mismatch": "minor",
    "summary": "All tool descriptions accurately reflect their primary operations; the main undocumented behaviours are implementation details common to every write tool: a journaled transaction system that creates manifest and snapshot files inside a hidden .mcp-obsidian directory within the vault, a directory-based filesystem lock, atomic writes via temporary files, and automatic .md extension appending. Startup silently creates those state directories and rolls back any previously interrupted transactions, which is also undocumented in the tool descriptions but consistent with the server's safety guarantees."
  },
  "server": "obsidian",
  "startup": [
    {
      "behaviour": "Writes diagnostic messages (warnings, errors) to stderr in a structured format",
      "documented_in_tool_descriptions": false,
      "evidence": "cli.js: runCli / writeDiagnostic calls; diagnostics.js: writeDiagnostic",
      "kind": "other",
      "observable_from_outside": "none",
      "security_relevance": "none"
    },
    {
      "behaviour": "Resolves and validates each vault path via fs.realpath and fs.stat, checks for .obsidian directory, checks read/write permissions",
      "documented_in_tool_descriptions": false,
      "evidence": "vault.js: VaultRegistry.create",
      "kind": "file_write",
      "observable_from_outside": "none",
      "security_relevance": "low"
    },
    {
      "behaviour": "Creates internal state directories inside each vault root: <vault>/.mcp-obsidian/transactions, .mcp-obsidian/trash, .mcp-obsidian/locks with mode 0o700",
      "documented_in_tool_descriptions": false,
      "evidence": "transaction.js: TransactionManager.initialize / fs.mkdir calls",
      "kind": "file_write",
      "observable_from_outside": "file",
      "security_relevance": "low"
    },
    {
      "behaviour": "On startup, acquires a filesystem lock, scans the transactions directory and rolls back any incomplete (preparing/committing) transactions, then prunes old transaction journals based on --recovery-days and --recovery-max-bytes",
      "documented_in_tool_descriptions": false,
      "evidence": "transaction.js: TransactionManager.initialize -> recoverIncomplete, prune",
      "kind": "file_write",
      "observable_from_outside": "file",
      "security_relevance": "medium"
    },
    {
      "behaviour": "Writes a JSON log line to stderr for every server start event",
      "documented_in_tool_descriptions": false,
      "evidence": "cli.js: logger.log('info', 'server_started', ...)",
      "kind": "other",
      "observable_from_outside": "none",
      "security_relevance": "none"
    },
    {
      "behaviour": "Registers SIGINT and SIGTERM signal handlers to close the MCP transport",
      "documented_in_tool_descriptions": false,
      "evidence": "cli.js: process.once('SIGINT'...) / process.once('SIGTERM'...)",
      "kind": "other",
      "observable_from_outside": "process",
      "security_relevance": "none"
    }
  ],
